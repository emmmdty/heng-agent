# ===== Server =====
PORT=8000
LOG_LEVEL=info
DATA_DIR=./data

# ===== LLM (OpenAI 兼容协议) =====
# 敏感项（LLM_BASE_URL / LLM_API_KEY）推荐通过环境变量注入：
#   export LLM_BASE_URL=<网关地址> LLM_API_KEY=<密钥>
# 环境变量优先于本文件；本文件仅作为本地开发兜底，已被 gitignore，勿提交真实密钥
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=mimo-v2.5

# ===== Embedding (OpenAI 兼容 /v1/embeddings，缺省复用 LLM_* 网关) =====
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIM=1024   # 换模型必须同步改，且要删掉旧 collection 重建（维度不匹配会建库失败）
#
# 自建方案（评测用，可复现且不烧网关配额）：Qwen3-Embedding-0.6B，dim=1024，
# 与 text-embedding-v4 同维，切换时无需改 EMBEDDING_DIM、无需重标定。
#   EMBEDDING_BASE_URL=http://127.0.0.1:11436/v1
#   EMBEDDING_API_KEY=local-no-auth
#   EMBEDDING_MODEL=qwen3-embedding-0.6b

# 向量库落盘根目录。空 = 跟随 DATA_DIR（单实例的默认行为）。
# 只在"要起第二个实例、又不想抢 Qdrant 文件锁"时配它——
# **不要改 DATA_DIR 来达到同样目的**：流水会跟着搬走，报告事后无法复算
# （2026-09-04 实测踩过，十九期整批读数因此作废）。
VECTOR_STORE_DIR=

# ===== 向量库 Qdrant（空 = qdrant-client 本地嵌入模式，落盘 VECTOR_STORE_DIR/qdrant） =====
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=globex_products

# ===== Reranker（空 = 降级为按向量分排序，rerank_applied=false） =====
# 参考服务端见 scripts/serve_reranker.py（Qwen3-Reranker-0.6B）：
#   python scripts/serve_reranker.py --model-dir <模型路径> --port 11437
# 实测收益（105 条标注，见 docs/设计演进记录.md 五期）：精排把 MRR 由 .863 提到 .914。
# 注意精排能否提升 Recall@K 取决于一阶段召回深度是否 > K，否则它只能重排不能补召回。
# RERANKER_BASE_URL=http://127.0.0.1:11437
# RERANKER_MODEL=qwen3-reranker-0.6b

# ===== Web 搜索 Tavily（空 = 不注册 web_search_tool） =====
# TAVILY_API_KEY=tvly-xxx

# ===== 可观测（空 = 不启用 TracingMiddleware） =====
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ===== 评测态故障注入（默认 0 = 关；生产进程必须保持关闭） =====
# 开启后：三个检索端口（embedding / vector_index / reranker）被包上装饰器，
# 并注册 POST /debug/faults 运行时开关；关闭时二者都不存在。
# eval/cases.yaml 里带 `faults:` 的用例需要它，否则整轮开跑前会被拦下。
#   FAULT_INJECTION_ENABLED=1 uv run uvicorn app.presentation.server:app --port 8000
#   curl -XPOST :8000/debug/faults -d '{"components":["reranker"]}' -H 'Content-Type: application/json'
#   curl -XPOST :8000/debug/faults -d '{"components":[]}' -H 'Content-Type: application/json'   # 清空
# FAULT_INJECTION_ENABLED=1
