.venv/
__pycache__/
*.pyc
.env
.pytest_cache/
.ruff_cache/
.claude/
data/
eval/report-*.md
eval/report-*.json
# 整轮跑测过程中的增量落盘（正常结束会自动删掉，中断时留下来供 --resume）
eval/partial-*.json
# 召回评测报告同样是每次跑测的产物，不入库；标注集（eval/*.jsonl）要入库
eval/recall-report-*.md
eval/category-recall-report-*.md
# bad_cases.jsonl 反过来必须入库：它是人工分诊结果的载体，丢了等于分诊白做
uvicorn.log
# 跑测运行日志：与 report-* 同为跑测产物，不入库
eval/*.log
# A/B 分流跑测产物：partial 是续跑态、run json / report 是最终产物
eval/ab-partial-*.json
eval/ab-run-*.json
eval/ab-report-*.md
eval/ab-judgeprobe-*.json
# cross 重判分析产物：复用执行产物重配对，同为跑测产物不入库
eval/ab-crossrejudge-*.json
# 记忆回放产物：mem- 前缀分桶，与 ab-* 同纪律不入库
eval/mem-partial-*.json
eval/mem-run-*.json
eval/mem-report-*.md
eval/mem-deposit-*.json
eval/mem-dualjudge-*.json
# Skill 线产物：skill- 前缀分桶，与 ab-*/mem-* 同纪律不入库
eval/skill-*

# 设计与开发过程文档（本地保留，不入公开仓库）
docs/
